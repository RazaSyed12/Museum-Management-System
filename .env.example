# The backend uses only the publishable (anon) key — never the secret/
# service-role key. Security is enforced by database RLS policies plus
# per-request Authorization forwarding (see backend/src/lib/supabaseClients.ts),
# not by holding a key that bypasses RLS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_anon_key_here
PORT=4000
# Not currently read by the backend (CORS is wide open for now — see
# backend/src/index.ts) but reserved for when it is restricted before launch.
ALLOWED_ORIGINS=http://localhost:3000
