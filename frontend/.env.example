# Copy to .env.local and fill in. Never commit the filled-in file.

# Visitor preview toggle (see src/mocks/*, src/lib/api/client.ts).
# Leave unset to retain the existing visitor fixtures. The staff portal
# uses authenticated backend adapters independently of this toggle.
# NEXT_PUBLIC_API_MOCKING=disabled

# Auth's own mocking toggle (src/lib/api/auth.ts) — separate from
# NEXT_PUBLIC_API_MOCKING above. Set to
# "disabled" to point sign-in/sign-up/etc. at the real backend, or
# "enabled" to use the mock accounts in src/mocks/data.ts. When unset,
# auth follows the staff portal mode (the real backend by default).
# NEXT_PUBLIC_AUTH_API_MOCKING=disabled

# Staff uses the imported backend by default, including shared sign-in.
# The account needs role=staff, an assigned tier, and active status.
# Set BOTH staff and auth mocking to enabled to explore the local demo.
# NEXT_PUBLIC_STAFF_API_MOCKING=enabled
# NEXT_PUBLIC_AUTH_API_MOCKING=enabled

# Collections/Categories' own mocking toggle (src/lib/api/collections.ts) —
# same idea as auth's. Visitor collection items remain on fixtures in this
# frontend; staff artefacts use the real item and media endpoints.
# NEXT_PUBLIC_COLLECTIONS_API_MOCKING=disabled

# Visitor events toggle (src/lib/api/events.ts). Its current adapter uses
# general admission and capacity. Staff event pricing and allocation
# management use the full authenticated backend contract separately.
# NEXT_PUBLIC_EVENTS_API_MOCKING=disabled

# Bookings' own mocking toggle (src/lib/api/bookings.ts) — the ticket flow
# (/tickets/...) and the profile's bookings tab. Set to "disabled" to book
# against the real backend (/events/{id}/allocations, /bookings/quote,
# /bookings, /bookings/{id}/pay, /me/bookings). Real booking needs a signed-in
# account, so set NEXT_PUBLIC_AUTH_API_MOCKING=disabled too, and
# NEXT_PUBLIC_EVENTS_API_MOCKING=disabled so event ids are the real UUIDs.
# Differences from the mock flow: one ticket type per booking (1-10 tickets),
# no child/student type, prices/tax/service fee/member discount come from the
# server in AUD, and a new booking is a 15-minute hold until it is paid.
# NEXT_PUBLIC_BOOKINGS_API_MOCKING=disabled

# Base URL of the real backend API (see ../backend), including staff calls.
# Base URL of the real backend API (see ../backend). Read whenever either
# mocking toggle above is "disabled" — ignored otherwise.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public site URL, used for absolute links and metadata, and as the
# fallback base for server-side fetches if NEXT_PUBLIC_API_BASE_URL isn't set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Membership's own mocking toggle (src/lib/api/membership.ts) — the /membership
# page, buying a plan at /membership/join and the member status on the
# profile. Set to "disabled" to use the real backend (/membership/plans,
# /membership/purchase, /me/membership). Buying needs a signed-in account, so
# set NEXT_PUBLIC_AUTH_API_MOCKING=disabled too. Plans, prices (AUD) and
# benefits then come from the museum's staff-managed data.
# NEXT_PUBLIC_MEMBERSHIP_API_MOCKING=disabled

# Membership's own mocking toggle (src/lib/api/membership.ts) — the /membership
# page, buying a plan at /membership/join and the member status on the
# profile. Set to "disabled" to use the real backend (/membership/plans,
# /membership/purchase, /me/membership). Buying needs a signed-in account, so
# set NEXT_PUBLIC_AUTH_API_MOCKING=disabled too. Plans, prices (AUD) and
# benefits then come from the museum's staff-managed data.
# NEXT_PUBLIC_MEMBERSHIP_API_MOCKING=disabled

# Profile's own mocking toggle (src/lib/api/preferences.ts) — the interests
# picker (/interests), the profile's Interests tab and the Settings name field.
# Set to "disabled" to use the real backend (/categories, /me/preferences,
# /me/profile): interests then are the museum's top-level categories, saved
# per account. Needs a signed-in account, so set
# NEXT_PUBLIC_AUTH_API_MOCKING=disabled too.
# NEXT_PUBLIC_PROFILE_API_MOCKING=disabled

# Hero's own mocking toggle (src/lib/api/hero.ts) — the homepage carousel.
# Set to "disabled" to show the slides staff manage in the portal (GET /hero:
# order, schedule, linked event or collection, buttons, image). Unset, or if
# staff have no slides yet, the carousel builds its slides from the soonest
# events plus the membership slide, as before.
# NEXT_PUBLIC_HERO_API_MOCKING=disabled

# Recommendations' own mocking toggle (src/lib/api/recommendations.ts) — the
# homepage "Recommended for you / What other visitors are exploring" row and the
# profile's "Because of what you've explored". Set to "disabled" to use the
# backend's ranking (GET /recommendations: the account's interest picks first,
# then recent history, then popular). Unset, both keep their fixed examples.
# NEXT_PUBLIC_RECOMMENDATIONS_API_MOCKING=disabled

# Interactions' own mocking toggle (src/lib/api/interactions.ts) — records that
# a signed-in visitor opened an event or collection (POST /me/interactions) so
# their recommendations improve. Guests are never tracked. Unset, nothing is
# recorded. (Searches are recorded by the backend itself, via /search.)
# NEXT_PUBLIC_INTERACTIONS_API_MOCKING=disabled
