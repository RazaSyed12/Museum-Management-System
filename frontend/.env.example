# Copy to .env.local and fill in. Never commit the filled-in file.

# Mock API toggle (see src/mocks/*, src/lib/api/client.ts). Leave this
# commented out / unset while there's no real backend: every lib/api/*
# call then answers from the fixtures in src/mocks/data.ts — client-side
# via MSW's browser worker, server-side (Server Components, including at
# build time) by calling src/mocks/resolve.ts directly instead of going
# over the network, since Next's server-side fetch patching doesn't play
# well with MSW's Node interceptor for SSR/SSG.
# Set to "disabled" once the real backend exists, to switch every call
# over to a real fetch against NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_API_MOCKING=disabled

# Base URL of the real backend API (see ../backend). Only read once
# NEXT_PUBLIC_API_MOCKING=disabled — ignored while mocking is on.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public site URL, used for absolute links and metadata, and as the
# fallback base for server-side fetches if NEXT_PUBLIC_API_BASE_URL isn't set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
