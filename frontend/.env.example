# Copy to .env.local and fill in. Never commit the filled-in file.

# Mock API toggle (see src/mocks/*, src/lib/api/client.ts). Leave this
# commented out / unset while collections/events/bookings don't have a
# real backend yet (their schemas don't match the real one in
# backend/openapi.yaml): every lib/api/* call then answers from the
# fixtures in src/mocks/data.ts — client-side via MSW's browser worker,
# server-side (Server Components, including at build time) by calling
# src/mocks/resolve.ts directly instead of going over the network, since
# Next's server-side fetch patching doesn't play well with MSW's Node
# interceptor for SSR/SSG.
# Set to "disabled" once those resources' real endpoints match the
# frontend's types, to switch every call over to a real fetch against
# NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_API_MOCKING=disabled

# Auth's own mocking toggle (src/lib/api/auth.ts) — separate from
# NEXT_PUBLIC_API_MOCKING above because /auth/* already matches the real
# backend exactly, even while collections/events/etc. still don't. Set to
# "disabled" to point sign-in/sign-up/etc. at the real backend, or
# "enabled" to use the mock accounts in src/mocks/data.ts. When unset,
# auth follows the staff portal mode (the real backend by default).
# NEXT_PUBLIC_AUTH_API_MOCKING=disabled

# Staff uses the existing backend by default, including the shared sign-in.
# Set BOTH staff and auth mocking to enabled to explore the local demo.
# NEXT_PUBLIC_STAFF_API_MOCKING=enabled
# NEXT_PUBLIC_AUTH_API_MOCKING=enabled

# Collections/Categories' own mocking toggle (src/lib/api/collections.ts) —
# same idea as auth's. Collection items/artefacts stay mocked regardless
# (no real /collections/{id}/items endpoint exists yet).
# NEXT_PUBLIC_COLLECTIONS_API_MOCKING=disabled

# Events' own mocking toggle (src/lib/api/events.ts). The real Event has no
# member/child ticket price and no remaining-seats tracking (no booking
# system exists yet) — real events show as always-available, single-price,
# which is the honest current state rather than a bug.
# NEXT_PUBLIC_EVENTS_API_MOCKING=disabled

# Base URL of the real backend API (see ../backend), including staff calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public site URL, used for absolute links and metadata, and as the
# fallback base for server-side fetches if NEXT_PUBLIC_API_BASE_URL isn't set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
